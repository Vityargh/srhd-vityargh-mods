          ]
        },
        {
          "Type": "Top",
          "Name": "FleetTurn",
          "Pos.x": 0,
          "Pos.y": 420,
          "Parent": -1,
          "#": 14,
          "Code.Type": "Turn",
          "Code": [
            "function ServiceReady() {",
            "    unknown ready_call=ImportedFunction('SmartLootService','SL_Ready');",
            "    { result=ready_call(); exit; }",
            "}",
            "function ServiceWork(dword star) {",
            "    unknown work_call=ImportedFunction('SmartLootService','SL_CountWork');",
            "    { result=work_call(star); exit; }",
            "}",
            "function ServicePrep(dword ship) {",
            "    unknown prepare_call=ImportedFunction('SmartLootService','SL_Prepare');",
            "    { result=prepare_call(ship); exit; }",
            "}",
            "function ServiceClean(dword ship,int quota) {",
            "    unknown cleanup_call=ImportedFunction('SmartLootService','SL_Clean');",
            "    { result=cleanup_call(ship,quota); exit; }",
            "}",
            "function ServiceMove(dword ship) {",
            "    unknown move_call=ImportedFunction('SmartLootService','SL_Move');",
            "    { result=move_call(ship); exit; }",
            "}",
            "function ServiceAtStar(int star_id,int exclude) {",
            "    int n=0,j=0;dword ship=0;",
            "    for(j=1;j<=15;j=j+1) {",
            "        if(j==exclude || SL_ids[j]==0)continue;",
            "        ",
            "        if(SL_dest[j]==star_id)n=n+1;",
            "        else if(SL_system[j]==star_id)n=n+1;",
            "    }",
            "    { result=n; exit; }",
            "}",
            "function ServiceName(int slot) {",
            "    if(slot%3==0){ result=CT('Script.Mod_SmartLootServiceV2.SCV01'); exit; }",
            "    if(slot%3==1){ result=CT('Script.Mod_SmartLootServiceV2.SCV02'); exit; }",
            "    { result=CT('Script.Mod_SmartLootServiceV2.SCV03'); exit; }",
            "}",
            "function ServiceAdopt(dword ship,int slot) {",
            "    if(!ship || ship==Player())exit;",
            "    SL_system[slot]=Id(ShipStar(ship));SL_ids[slot]=Id(ship);SL_dest[slot]=0;SL_qturn[slot]=CurTurn();SL_used[slot]=10;",
            "    ShipJoin(ServiceGroup,ship,'ServiceIdle');",
            "    SetName(ship,ServiceName(slot));",
            "    NoDropToShip(ship,1);NoTargetToShip(ship,1);",
            "    ServicePrep(ship);",
            "}",
            "function ServiceTurn() {",
            "    int i=0,j=0,k=0,n=0,count=0,free_slot=-1,dest_id=0,work=0;",
            "    dword ship=0,star=0,planet=0,destination=0;",
            "    if(!SL_started){",
            "        SL_started=1;SL_first=CurTurn();",
            "        ArrayClear(SL_system);ArrayAdd(SL_system,0);ArrayClear(SL_ids);ArrayAdd(SL_ids,0);ArrayClear(SL_dest);ArrayAdd(SL_dest,0);ArrayClear(SL_qturn);ArrayAdd(SL_qturn,0);ArrayClear(SL_used);ArrayAdd(SL_used,0);",
            "        for(i=1;i<=15;i=i+1){ArrayAdd(SL_system,0);ArrayAdd(SL_ids,0);ArrayAdd(SL_dest,0);ArrayAdd(SL_qturn,0);ArrayAdd(SL_used,0);}",
            "        exit;",
            "    }",
            "    if(CurTurn()<=SL_first)exit;",
            "    if(SL_busy && SL_busy_turn==CurTurn())exit;",
            "    SL_busy=1;SL_busy_turn=CurTurn();",
            "    // Native part not running (no XenoNativeLoader or unsupported game build): tell the player once per save.",
            "    if(!ServiceReady()){",
            "        SL_busy=0;",
            "        if(!SL_warned){SL_warned=1;MessageBox(CT('Script.Mod_SmartLootServiceV2.NoLoader'));}",
            "        exit;",
            "    }",
            "    SL_warned=0;",
            "    if(GalaxyStars()==0){SL_busy=0;exit;}",
            "    SL_cursor=(SL_cursor+1)%GalaxyStars();",
            "    dword candidate=GalaxyStar(SL_cursor);",
            "    if(!candidate){SL_busy=0;exit;}",
            "    dword legacy_ship=0;",
            "    // Bounded migration: inspect just this system; no fresh fleet until first sweep.",
            "    for(j=0;j<StarShips(candidate);j=j+1) {",
            "        legacy_ship=StarShips(candidate,j);if(!legacy_ship || legacy_ship==Player())continue;",
            "        if(ShipTypeN(legacy_ship)>=t_RC)continue;",
            "        if(ShipName(legacy_ship)!='SmartLootAI - Janitor')continue;",
            "        free_slot=-1;",
            "        for(i=1;i<=15;i=i+1){if(SL_ids[i]==0){free_slot=i;break;}}",
            "        if(free_slot>0 && ServiceAtStar(Id(candidate),-1)<2)ServiceAdopt(legacy_ship,free_slot);",
            "        else {NoDropToShip(legacy_ship,1);ShipDestroy(legacy_ship);}",
            "    }",
            "    if(SL_cursor==0)SL_scan_complete=1;",
            "    free_slot=-1;",
            "    for(i=1;i<=15;i=i+1) {",
            "        ship=IdToShip(SL_ids[i]);",
            "        if(!ship){SL_ids[i]=0;SL_dest[i]=0;if(free_slot<0)free_slot=i;continue;}",
            "        count=count+1;",
            "        if(ship==Player())continue;",
            "        if(ShipTypeN(ship)>=t_RC)continue;",
            "        ServicePrep(ship);",
            "        if(ShipInHyperSpace(ship) || ShipIsTakeoff(ship))continue;",
            "        if(!ShipInNormalSpace(ship)) {",
            "            if(GetShipPlanet(ship) || GetShipRuins(ship))OrderTakeOff(ship);",
            "            continue;",
            "        }",
            "        star=ShipStar(ship);if(!star)continue;SL_system[i]=Id(star);",
            "        if(SL_dest[i] && Id(star)!=SL_dest[i])continue;",
            "        SL_dest[i]=0;",
            "        if(SL_qturn[i]!=CurTurn()){SL_qturn[i]=CurTurn();SL_used[i]=0;}",
            "        if(SL_used[i]<10) {",
            "            n=10-SL_used[i];SL_used[i]=10;",
            "            ServiceClean(ship,n);",
            "        }",
            "        work=ServiceWork(star);",
            "        if(work>0){ServiceMove(ship);continue;}",
            "        destination=0;",
            "        if(candidate!=star && ServiceAtStar(Id(candidate),i)<2 && ServiceWork(candidate)>0)destination=candidate;",
            "        if(destination){SL_dest[i]=Id(destination);OrderJump(ship,destination);}",
            "        else ServiceMove(ship);",
            "    }",
            "    // Spawn at most one per turn; assign metadata before reentrant callbacks.",
            "    if(SL_scan_complete && count<10 && free_slot>0) {",
            "        planet=0;",
            "        star=candidate;",
            "        if(ServiceAtStar(Id(star),-1)<2 && ServiceWork(star)>0) {",
            "            if(StarPlanets(star)>0) {",
            "                SL_planet_cursor=(SL_planet_cursor+1)%StarPlanets(star);",
            "                planet=StarPlanets(star,SL_planet_cursor);",
            "                if(planet) {if(PlanetRace(planet)!=People || PlanetOwner(planet)!=People)planet=0;}",
            "            }",
            "        }",
            "        if(planet) {",
            "            ship=BuyTransport(planet,2,100);",
            "            if(ship && ship!=Player()) {",
            "                ServiceAdopt(ship,free_slot);",
            "                OrderTakeOff(ship);",
            "            }",
            "        }",
            "    }",
            "    SL_busy=0;",
            "}",
            "ServiceTurn();"
          ]
        },
